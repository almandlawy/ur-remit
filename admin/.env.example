# لوحة إدارة أور تتصل مباشرة بمشروع Supabase (بدون خادم Fastify وسيط).
# انسخ هذا الملف إلى .env.local محلياً، وأضف نفس المتغيرين كمتغيرات بيئة على منصة الاستضافة
# (Vercel / Render) — بدون رفع أي قيم حقيقية إلى git.

# نفس رابط المشروع المستخدم في تطبيق iOS (Info.plist -> SUPABASE_URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# المفتاح العام (anon / publishable key) — نفس المفتاح المستخدم في تطبيق iOS.
# لا تضع هنا service_role key أبداً؛ هذا المفتاح يخضع بالكامل لسياسات RLS.
SUPABASE_PUBLISHABLE_KEY=<anon-public-key>
