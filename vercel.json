{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastify",
      "entrypoint": "dist/server.js",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "admin" } }
  ]
}
